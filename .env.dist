# Adobe Commerce App Builder runtime configuration
# Copy to .env for local development; do not commit .env

# This extension does not require external credentials.
# Add future SaaS/PaaS secrets here as needed using the AIO_COMMERCE_AUTH_IMS_* family.

# Example placeholders for future expansion:
# AIO_COMMERCE_API_BASE_URL=
# AIO_COMMERCE_AUTH_IMS_CLIENT_ID=
# AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=
# AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=
# AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=
# AIO_COMMERCE_AUTH_IMS_ORG_ID=
# AIO_COMMERCE_AUTH_IMS_SCOPES=
